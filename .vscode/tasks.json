{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "detail": "vue-tsc + vite build（整仓前端）"
    },
    {
      "label": "tauri:dev",
      "type": "shell",
      "command": "npm run tauri -- dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(App|Finished|running|Local:|5173)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "detail": "启动 Vite + Tauri 桌面窗"
    }
  ]
}
